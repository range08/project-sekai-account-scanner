# KR API credentials for the optional live backend. Replace locally; never commit.
SEKAI_KR_SDK_OPEN_ID=replace-me
SEKAI_KR_ACCESS_TOKEN=replace-me
SEKAI_KR_DEVICE_ID=replace-me
SEKAI_KR_INSTALL_ID=replace-me
SEKAI_KR_USER_AGENT=replace-me
SEKAI_KR_DEVICE_MODEL=replace-me
SEKAI_KR_OS_VERSION=replace-me

# Required by the upstream AES protocol. Supply locally; do not commit values.
AES_KEY=
AES_IV=

# Optional KR version/hash fallbacks if the upstream app-identity feed is unavailable.
# APP_VER=...
# APP_HASH=...

# Path to a sekai-client checkout at the revision documented in README.md.
SEKAI_CLIENT_PATH=
